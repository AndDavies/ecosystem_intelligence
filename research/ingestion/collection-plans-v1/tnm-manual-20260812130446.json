  "priorityQuestions": [
    {
      "questionId": "identity-canadian-nexus",
      "subjectType": "organization",
      "question": "Which organizations have a current, concrete Canadian ROV or underwater-inspection operating capability?",
      "targetFieldPaths": [
        "organization.name",
        "organization.legalName",
        "organization.ownership",
        "organization.primaryLocation"
      ],
      "evidenceThreshold": "one_anchor"
    },
    {
      "questionId": "capability-and-maturity",
      "subjectType": "technology",
      "question": "Which technical specifications and applications are supported by durable product or service documentation?",
      "targetFieldPaths": [
        "capabilities",
        "organization.commercialStatus",
        "organization.operatingContext"
      ],
      "evidenceThreshold": "one_anchor"
    },
    {
      "questionId": "current-delivery-boundary",
      "subjectType": "signal",
      "question": "Which independent public records establish current delivery maturity without implying defence adoption?",
      "targetFieldPaths": [
        "organization.currentActivity",
        "capabilities.maturity",
        "relationships"
      ],
      "evidenceThreshold": "anchor_plus_independent_corroboration"
    },
    {
      "questionId": "identity-conflict-disposition",
      "subjectType": "organization",
      "question": "Which identities, ownership boundaries, lifecycle conflicts or foreign-umbrella relationships remain unresolved?",
      "targetFieldPaths": [
        "organization.ownership",
        "reviewWarnings",
        "deferred"
      ],
      "evidenceThreshold": "one_anchor"
    }
  ],
  "collectionLanes": [
    {
      "lane": "official_site",
      "purpose": "Resolve current identity, location, public contact and ROV service scope from official organization pages.",
      "sourcePosture": "evidence_anchor",
      "queryPatterns": [
        "Canadian ROV inspection company official site"
      ],
      "expectedClaims": [
        "Current identity",
        "Canadian location",
        "Public contact route"
      ]
    },
    {
      "lane": "technical_documents",
      "purpose": "Recover model-specific ROV, sonar, tooling, tether, payload and launch-and-recovery specifications.",
      "sourcePosture": "evidence_anchor",
      "queryPatterns": [
        "Canadian ROV technical datasheet"
      ],
      "expectedClaims": [
        "Technical features",
        "Applications",
        "Configuration limits"
      ]
    },
    {
      "lane": "government_procurement",
      "purpose": "Resolve current government program and procurement evidence while keeping general marine work distinct from ROV adoption.",
      "sourcePosture": "strong_corroboration",
      "queryPatterns": [
        "site:canada.ca Canadian ROV operator"
      ],
      "expectedClaims": [
        "Program participation",
        "Current activity"
      ]
    },
    {
      "lane": "customer_partner_program",
      "purpose": "Corroborate deployments, expeditions and operating relationships through named customers, partners or programs.",
      "sourcePosture": "strong_corroboration",
      "queryPatterns": [
        "Canadian ROV customer expedition"
      ],
      "expectedClaims": [
        "Named use",
        "Operating maturity"
      ]
    },
    {
      "lane": "industry_publication",
      "purpose": "Seek independent operating, safety, workforce and maturity corroboration from relevant industry sources.",
      "sourcePosture": "strong_corroboration",
      "queryPatterns": [
        "Canadian Association of Diving Contractors ROV"
      ],
      "expectedClaims": [
        "Current directory presence",
        "Operating identity"
      ]
    },
    {
      "lane": "corporate_registry",
      "purpose": "Resolve legal names, renames, successors, acquisitions and parent or subsidiary relationships.",
      "sourcePosture": "strong_corroboration",
      "queryPatterns": [
        "Canadian ROV company registry acquisition rename"
      ],
      "expectedClaims": [
        "Legal identity",
        "Lifecycle",
        "Ownership boundary"
      ]
    },
    {
      "lane": "bilingual_public_web",
      "purpose": "Search French-language Canadian public records for missed operators, awards, identities and contradictions.",
      "sourcePosture": "discovery_only",
      "queryPatterns": [
        "entreprise canadienne inspection sous-marine ROV"
      ],
      "expectedClaims": [
        "Additional Canadian operator",
        "Bilingual corroboration"
      ]
    },
    {
      "lane": "ecosystem_directory",
      "purpose": "Close finite Canadian operator, foreign-umbrella and out-of-scope trails without padding the prospect universe.",
      "sourcePosture": "discovery_only",
      "queryPatterns": [
        "Canadian launch and recovery system ROV"
      ],
      "expectedClaims": [
        "Exclusion reason",
        "Unresolved trail"
      ]
    }
  ],

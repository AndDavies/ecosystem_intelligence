{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "public-atlas-candidate-batch.schema.json",
  "title": "Public Atlas Candidate Batch",
  "type": "object",
  "required": ["batchId", "title", "status", "createdAt", "approvedAt", "reviewedBy", "missionAreaSlug", "records"],
  "properties": {
    "batchId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": { "const": "approved" },
    "createdAt": { "type": "string", "format": "date-time" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "reviewedBy": { "type": "string", "minLength": 1 },
    "missionAreaSlug": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "name", "description", "websiteUrl", "city", "provinceTerritory", "latitude", "longitude", "confidence", "capability", "source"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 40 },
          "websiteUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "city": { "type": "string", "minLength": 1 },
          "provinceTerritory": { "type": "string", "minLength": 1 },
          "latitude": { "type": "number", "minimum": 41, "maximum": 84 },
          "longitude": { "type": "number", "minimum": -142, "maximum": -52 },
          "confidence": { "enum": ["high", "moderate"] },
          "capability": {
            "type": "object",
            "required": ["slug", "name", "summary", "type", "features", "applications", "tags", "technicalDomainSlug", "alignmentSummary"],
            "properties": {
              "slug": { "type": "string" }, "name": { "type": "string" }, "summary": { "type": "string" }, "type": { "type": "string" },
              "features": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "applications": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "technicalDomainSlug": { "type": "string" }, "clusterSlug": { "type": ["string", "null"] }, "alignmentSummary": { "type": "string" }
            },
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "required": ["title", "url", "publisher", "type", "excerpt"],
            "properties": {
              "title": { "type": "string" }, "url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "publisher": { "type": "string" }, "type": { "type": "string" }, "excerpt": { "type": "string", "minLength": 30 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

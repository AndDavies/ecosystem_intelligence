{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truenorthmap.ca/schemas/research-prospect-inventory-v1.schema.json",
  "title": "True North Map Research Prospect Inventory",
  "description": "A broad, inexpensive discovery universe retained before evidence qualification and candidate building.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inventoryId", "runId", "createdAt", "scope", "prospects"],
  "properties": {
    "schemaVersion": { "const": "research_prospect_inventory_v1" },
    "inventoryId": { "$ref": "#/$defs/slug" },
    "runId": { "$ref": "#/$defs/slug" },
    "createdAt": { "type": "string", "format": "date-time" },
    "scope": { "type": "string", "minLength": 40 },
    "prospects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 75,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "proposedEntityType", "proposedOrganizationKind", "canonicalUrl", "discoverySourceUrl", "discoveryLane", "countryCode", "fitSummary", "disposition", "rejectionReason", "recoveryAttempts"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "name": { "type": "string", "minLength": 2 },
          "proposedEntityType": { "enum": ["organization", "demand_signal", "program", "relationship"] },
          "proposedOrganizationKind": { "oneOf": [{ "$ref": "#/$defs/organizationKind" }, { "type": "null" }] },
          "canonicalUrl": { "oneOf": [{ "$ref": "#/$defs/httpsUrl" }, { "type": "null" }] },
          "discoverySourceUrl": { "$ref": "#/$defs/httpsUrl" },
          "discoveryLane": { "$ref": "#/$defs/discoveryLane" },
          "countryCode": { "type": ["string", "null"], "minLength": 2, "maxLength": 2 },
          "fitSummary": { "type": "string", "minLength": 30 },
          "disposition": { "enum": ["queued", "selected", "rejected", "duplicate"] },
          "rejectionReason": { "type": ["string", "null"] },
          "recoveryAttempts": { "type": "array", "items": { "$ref": "#/$defs/recoveryAttempt" } }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "organizationKind": { "enum": ["company", "accelerator", "incubator", "research_test_centre", "investor_funder", "ecosystem_organization", "government_innovation_office"] },
    "discoveryLane": { "enum": ["official_directory", "corporate_registry", "patent_ip", "proactive_disclosure", "lobbying_registry", "government_awards", "government_program", "procurement", "accelerator_cohort", "investor_portfolio", "industry_association", "conference_directory", "company_newsroom", "technical_documentation", "customer_partner", "bilingual_web", "broad_web"] },
    "recoveryAttempt": { "type": "object", "required": ["lane", "url", "outcome"], "properties": { "lane": { "$ref": "#/$defs/discoveryLane" }, "url": { "$ref": "#/$defs/httpsUrl" }, "outcome": { "type": "string", "minLength": 20 } } }
  }
}

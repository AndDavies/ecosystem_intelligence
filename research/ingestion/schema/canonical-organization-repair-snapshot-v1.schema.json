{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truenorthmap.ca/schemas/canonical-organization-repair-snapshot-v1.schema.json",
  "title": "True North Map Canonical Organization Repair Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "capturedAt", "targets"],
  "properties": {
    "schemaVersion": { "const": "canonical_organization_repair_snapshot_v1" },
    "runId": { "$ref": "#/$defs/slug" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "uuidList50": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uuid" }
    },
    "uuidList100": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uuid" }
    },
    "uuidList500": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uuid" }
    },
    "relationKeyList": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      }
    },
    "capabilityDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeDomainKeys", "activeMissionMatchIds", "activeClusterKeys", "activeDemandMatchIds", "activeMediaAssetIds", "signalRecordLinkIds", "wikiPageRecordLinkIds"],
      "properties": {
        "activeDomainKeys": { "$ref": "#/$defs/relationKeyList" },
        "activeMissionMatchIds": { "$ref": "#/$defs/uuidList100" },
        "activeClusterKeys": { "$ref": "#/$defs/relationKeyList" },
        "activeDemandMatchIds": { "$ref": "#/$defs/uuidList100" },
        "activeMediaAssetIds": { "$ref": "#/$defs/uuidList50" },
        "signalRecordLinkIds": { "$ref": "#/$defs/uuidList100" },
        "wikiPageRecordLinkIds": { "$ref": "#/$defs/uuidList100" }
      }
    },
    "organizationDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeDomainKeys", "activeMissionMatchIds", "activeClusterKeys", "activeDemandMatchIds", "activeMediaAssetIds", "signalRecordLinkIds", "wikiPageRecordLinkIds", "activeAliasIds", "activeLocationLinkIds", "activeCapabilityIds", "activeProgramParticipationIds", "activeRelationshipIds", "activeFundingEventIds", "incomingActiveRelationshipIds"],
      "properties": {
        "activeDomainKeys": { "$ref": "#/$defs/relationKeyList" },
        "activeMissionMatchIds": { "$ref": "#/$defs/uuidList100" },
        "activeClusterKeys": { "$ref": "#/$defs/relationKeyList" },
        "activeDemandMatchIds": { "$ref": "#/$defs/uuidList100" },
        "activeMediaAssetIds": { "$ref": "#/$defs/uuidList50" },
        "signalRecordLinkIds": { "$ref": "#/$defs/uuidList100" },
        "wikiPageRecordLinkIds": { "$ref": "#/$defs/uuidList100" },
        "activeAliasIds": { "$ref": "#/$defs/uuidList50" },
        "activeLocationLinkIds": { "$ref": "#/$defs/uuidList50" },
        "activeCapabilityIds": { "$ref": "#/$defs/uuidList50" },
        "activeProgramParticipationIds": { "$ref": "#/$defs/uuidList50" },
        "activeRelationshipIds": { "$ref": "#/$defs/uuidList50" },
        "activeFundingEventIds": { "$ref": "#/$defs/uuidList50" },
        "incomingActiveRelationshipIds": { "$ref": "#/$defs/uuidList50" }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "name", "legalName", "websiteUrl", "entityKind", "organizationCategories", "profileData", "publicationStatus", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 2, "maxLength": 240 },
        "legalName": { "type": ["string", "null"], "minLength": 2, "maxLength": 240 },
        "websiteUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
        "entityKind": { "enum": ["company", "accelerator", "incubator", "research_test_centre", "investor_funder", "ecosystem_organization", "government_innovation_office"] },
        "organizationCategories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["commercial_company", "defence_supplier", "dual_use", "venture_capital", "corporate_venture", "public_funder", "dual_use_accelerator", "ocean_technology", "university_affiliated", "test_range", "research_lab", "cluster_operator", "industry_association", "government_program_operator"] }
        },
        "profileData": { "type": "object" },
        "publicationStatus": { "const": "published" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "alias", "aliasType", "publicationStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "alias": { "type": "string", "minLength": 2, "maxLength": 240 },
        "aliasType": { "enum": ["legal_name", "trade_name", "former_name", "acronym", "other"] },
        "publicationStatus": { "enum": ["draft", "published"] }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "name", "publicationStatus", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 2, "maxLength": 240 },
        "publicationStatus": { "enum": ["draft", "published"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "activeAliases", "activeCapabilities", "organizationDependencies", "capabilityDependencies", "publicationBlockers"],
      "properties": {
        "organization": { "$ref": "#/$defs/organization" },
        "activeAliases": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/alias" } },
        "activeCapabilities": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/capability" } },
        "organizationDependencies": { "$ref": "#/$defs/organizationDependencies" },
        "capabilityDependencies": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capabilityId", "dependencies"],
            "properties": {
              "capabilityId": { "$ref": "#/$defs/uuid" },
              "dependencies": { "$ref": "#/$defs/capabilityDependencies" }
            }
          }
        },
        "publicationBlockers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["savedCollectionItemIds", "activeConnectionRequestIds", "activeSubmissionIds", "incomingRedirectIds"],
          "properties": {
            "savedCollectionItemIds": { "$ref": "#/$defs/uuidList500" },
            "activeConnectionRequestIds": { "$ref": "#/$defs/uuidList500" },
            "activeSubmissionIds": { "$ref": "#/$defs/uuidList500" },
            "incomingRedirectIds": { "$ref": "#/$defs/uuidList500" }
          }
        }
      }
    }
  }
}

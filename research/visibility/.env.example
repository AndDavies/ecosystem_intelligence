# Copy to research/visibility/local/.env and keep the local file private.
TNM_VISIBILITY_GOOGLE_ACCESS_TOKEN=
TNM_VISIBILITY_GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
TNM_VISIBILITY_GOOGLE_CLIENT_ID=
TNM_VISIBILITY_GOOGLE_CLIENT_SECRET=
TNM_VISIBILITY_GSC_PROPERTY=https://truenorthmap.ca/
TNM_VISIBILITY_GA4_PROPERTY=
TNM_VISIBILITY_PAGESPEED_API_KEY=
TNM_VISIBILITY_BING_API_KEY=
TNM_VISIBILITY_CRUX_API_KEY=
TNM_VISIBILITY_GSC_BULK_PROJECT=
TNM_VISIBILITY_GSC_BULK_DATASET=
# ISO-8601 activation time. During Google's documented first-48-hour table warm-up,
# a configured export remains visible as pending without failing strict refreshes.
TNM_VISIBILITY_GSC_BULK_ACTIVATED_AT=
TNM_VISIBILITY_DATAFORSEO_LOGIN=
TNM_VISIBILITY_DATAFORSEO_PASSWORD=
TNM_VISIBILITY_DASHBOARD_INGEST_URL=
TNM_VISIBILITY_DASHBOARD_INGEST_TOKEN=
TNM_VISIBILITY_DASHBOARD_SITES_BYPASS_TOKEN=

# Production database configuration. The application and research pipeline
# fail closed when these values are unavailable; there is no bundled data mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for approved editorial operations. Never expose this value to
# the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated HMAC secret for exact-deployment cold dossier release probes. It
# may be omitted locally, where the gate derives a stable value from the local
# service credential. Production stores the matching derived value separately
# so parallel valid Supabase keys do not break release verification.
DOSSIER_RELEASE_PROBE_SECRET=

# Absolute public URL used in OAuth and passwordless-email callbacks.
# Production: https://truenorthmap.ca
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Cloudflare Turnstile site key used to protect passwordless-email
# initiation. The corresponding secret is stored only in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only Cloudflare Turnstile secret for contact, feedback, and update forms.
TURNSTILE_SECRET_KEY=

# Domain-restricted MapTiler browser key. When absent, local development uses an
# OpenStreetMap raster fallback with attribution.
NEXT_PUBLIC_MAPTILER_KEY=

# Optional MapTiler map ID. The default is the low-detail dataviz-light style.
NEXT_PUBLIC_MAPTILER_MAP_ID=dataviz-light

# Optional Google Analytics 4 measurement ID. Public-page measurement loads
# only after the visitor explicitly opts in.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# High-entropy IndexNow public verification token. Store it in server-side
# configuration, expect the protocol-required root key file to expose it, and
# never reuse it as an authentication credential.
INDEXNOW_KEY=

# Optional Microsoft Clarity project ID. Clarity loads only on public routes
# after the visitor separately allows experience diagnostics. Free-form forms
# are explicitly masked and private workflows are always excluded.
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=

# Server-only OpenAI key for Ask True North. Never expose this value to the
# browser or prefix it with NEXT_PUBLIC_. Discovery falls back safely when absent.
OPENAI_API_KEY=
# Optional public assistant only: explicitly choose a model; no default.
# Codex research does not use this setting or an OpenAI API key.
OPENAI_MODEL=

# Optional server-only MailerLite delivery integration. The application stores
# consent locally first, then mirrors active subscribers into a master lifecycle
# group plus independently consented delivery groups. Never expose these values
# to the browser. Keep Defence Signal alerts disabled unless the compatible
# schema/application and every provider group, Preference Center, activity-proof
# and RSS prerequisite are configured and verified.
MAILERLITE_API_TOKEN=
# Backward-compatible alias for MAILERLITE_MASTER_GROUP_ID.
MAILERLITE_GROUP_ID=
MAILERLITE_MASTER_GROUP_ID=
MAILERLITE_WEEKLY_GROUP_ID=
MAILERLITE_SIGNAL_ALERTS_GROUP_ID=
MAILERLITE_WEBHOOK_SECRET=
NEXT_PUBLIC_DEFENCE_SIGNAL_ALERTS_ENABLED=false
MAILERLITE_PREFERENCE_CENTER_ENABLED=false
# Enable only after a live read proves Preference Center activity includes the
# exact group and an explicit event time. New consent also requires that signed
# event within five minutes of receipt and activity corroboration within five
# minutes of the event.
MAILERLITE_PREFERENCE_ACTIVITY_VERIFIED=false

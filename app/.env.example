# Production database configuration. The application and research pipeline
# fail closed when these values are unavailable; there is no bundled data mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for approved editorial operations. Never expose this value to
# the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute public URL used in OAuth and passwordless-email callbacks.
# Production: https://truenorthmap.ca
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Cloudflare Turnstile site key used to protect passwordless-email
# initiation. The corresponding secret is stored only in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Domain-restricted MapTiler browser key. When absent, local development uses an
# OpenStreetMap raster fallback with attribution.
NEXT_PUBLIC_MAPTILER_KEY=

# Optional MapTiler map ID. The default is the low-detail dataviz-light style.
NEXT_PUBLIC_MAPTILER_MAP_ID=dataviz-light

# Optional Google Analytics 4 measurement ID. Public-page measurement loads
# only after the visitor explicitly opts in.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Optional Microsoft Clarity project ID. Clarity loads only on public routes
# after the visitor separately allows experience diagnostics. Free-form forms
# are explicitly masked and private workflows are always excluded.
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=

# Server-only OpenAI key for Ask True North. Never expose this value to the
# browser or prefix it with NEXT_PUBLIC_. Discovery falls back safely when absent.
OPENAI_API_KEY=

# Optional server-only MailerLite delivery integration. The application stores
# consent locally first, then mirrors active subscribers into one dedicated
# MailerLite group. Never expose these values to the browser.
MAILERLITE_API_TOKEN=
MAILERLITE_GROUP_ID=
MAILERLITE_WEBHOOK_SECRET=

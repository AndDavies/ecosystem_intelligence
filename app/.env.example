# Public atlas data source. Keep validated_seed until the new project has been
# migrated, seeded, and verified.
ATLAS_DATA_SOURCE=validated_seed

# Supabase public browser/server configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for approved editorial operations. Never expose this value to
# the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute public URL used in magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Domain-restricted MapTiler browser key. When absent, local development uses an
# OpenStreetMap raster fallback with attribution.
NEXT_PUBLIC_MAPTILER_KEY=

# Legacy internal workspace switch. Leave unset for the public atlas.
LEGACY_DATA_SOURCE=

# Optional provider for future constrained natural-language parsing. The
# current discovery endpoint is deterministic and does not require this.
OPENAI_API_KEY=
